# OpenWeather API key, used by the OpenWeather MCP server (external process).
# Get a free key at https://openweathermap.org/api, then export it in your
# shell before starting the agent. Never commit a real key to this file.
OWM_API_KEY=your_openweathermap_api_key_here

# Optional: absolute path to the mcp-openweather binary (see README ->
# Configuration for how to build it). Only needed if the binary isn't on
# PATH; if unset, agent/main.py falls back to the bare command
# "mcp-openweather" and relies on PATH to resolve it. Typical Windows
# location after `go install`:
# MCP_OPENWEATHER_PATH=C:\Users\<you>\go\bin\mcp-openweather.exe
